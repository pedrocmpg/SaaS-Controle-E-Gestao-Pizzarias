// Schema do banco de dados - E Tenho Ditto Pizzaria
// Suporta PostgreSQL (produção) e SQLite (desenvolvimento local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FlavorType {
  SALGADA
  DOCE
}

enum ProductCategory {
  COMBO
  BEBIDA
  ESPECIAL
  EXTRA
  RODIZIO
}

enum DeliveryType {
  ENTREGA
  RETIRADA
}

enum OrderStatus {
  RECEBIDO
  EM_PREPARO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

/// Origem do pedido. Fase 1 = só TELEFONE; demais reservados para a fase 2 (integrações).
enum OrigemPedido {
  TELEFONE
  IFOOD
  ANOTA_AI
  WHATSAPP
  BALCAO
}

enum StatusComanda {
  ABERTA
  FECHADA
  CANCELADA
}

enum ModoAdicionalSabor {
  CHEIO
  // PROPORCIONAL — reservado para fase futura, cálculo não implementado ainda
}

enum TipoBotaoPDV {
  PIZZA
  PRODUTO
}

/// Caixa do salão e da tele-entrega são fundos separados (não se misturam)
enum TipoCaixa {
  SALAO
  TELE_ENTREGA
}

enum StatusCaixa {
  ABERTO
  FECHADO_AGUARDANDO_CONFERENCIA
  CONFERIDO
}

enum TipoMovimentoCaixa {
  SANGRIA
  SUPRIMENTO
}

enum StatusTurnoMotoboy {
  ABERTO
  FECHADO_AGUARDANDO_CONFERENCIA
  CONFERIDO
}

/// Forma de pagamento aceita. Enum (e não String livre) para que o banco rejeite variações
/// como "Dinheiro"/"dinheiro": um valor fora da lista sai silenciosamente do acerto do
/// motoboy e do breakdown do caixa — sem erro, só dinheiro a menos na conta.
enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
}

/// O que está sendo impresso. Determina o layout e, no diagnóstico, qual tabela
/// consultar a partir de JobImpressao.origemId.
enum TipoImpressao {
  COMANDA_COZINHA
  CUPOM_CLIENTE
  ROMANEIO_MOTOBOY
}

enum StatusImpressao {
  PENDENTE
  IMPRESSO
  ERRO
}

/// Categoria de valor extra lançado no turno do motoboy (além de entregas + aluguel)
enum TipoExtraMotoboy {
  ENTREGA_LONGA
  GORJETA
  AJUDA_CUSTO
  OUTRO
}

/// Tamanhos de pizza "Monte a sua" (Pequena, Média, Grande)
/// maxFlavors é o "máx. de sabores simultâneos" configurável por tamanho (mesmo
/// conceito que o spec do PDV em grade chama de maxSabores — reaproveitado).
model PizzaSize {
  id            Int      @id @default(autoincrement())
  lojaId        Int
  loja          Loja     @relation(fields: [lojaId], references: [id])
  name          String
  slug          String
  slices        Int
  maxFlavors    Int
  servesPeople  Int
  price         Decimal  @db.Decimal(10, 2)
  precoDelivery Decimal? @db.Decimal(10, 2)
  codigo        String?
  imageUrl      String?
  description   String?
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  botoesPdv BotaoPDV[]

  @@unique([lojaId, slug])
  @@index([lojaId])
  @@map("pizza_sizes")
}

/// Sabores disponíveis (salgados e doces). extraPrice é o "adicional" somado
/// ao preço da pizza quando o sabor é escolhido (mesmo conceito do spec do PDV).
model Flavor {
  id          Int        @id @default(autoincrement())
  lojaId      Int
  loja        Loja       @relation(fields: [lojaId], references: [id])
  name        String
  description String?
  type        FlavorType
  extraPrice  Decimal    @default(0) @db.Decimal(10, 2)
  codigo      String?
  imageUrl    String?
  active      Boolean    @default(true)
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([lojaId])
  @@map("flavors")
}

/// Bordas recheadas
model Border {
  id     Int        @id @default(autoincrement())
  lojaId Int
  loja   Loja       @relation(fields: [lojaId], references: [id])
  name   String
  price  Decimal    @db.Decimal(10, 2)
  type   FlavorType
  active Boolean    @default(true)
  order  Int        @default(0)

  @@index([lojaId])
  @@map("borders")
}

/// Produtos fixos: combos, pizza vulcão, bebidas, extras e rodízio (por produto,
/// configurados na grade do PDV via BotaoPDV).
model Product {
  id            Int             @id @default(autoincrement())
  lojaId        Int
  loja          Loja            @relation(fields: [lojaId], references: [id])
  name          String
  description   String?
  price         Decimal         @db.Decimal(10, 2)
  precoDelivery Decimal?        @db.Decimal(10, 2)
  codigo        String?
  servesPeople  Int?
  imageUrl      String?
  category      ProductCategory
  active        Boolean         @default(true)
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  ofertas       OfertaProduto[]

  botoesPdv BotaoPDV[]

  @@index([lojaId])
  @@map("products")
}

/// Oferta/promoção de cardápio: vincula produtos específicos com um preço
/// promocional e (opcionalmente) uma janela de validade. Distinta de
/// Product.category=COMBO/ESPECIAL — Oferta é uma composição de produtos
/// existentes, não um item de cardápio próprio.
model Oferta {
  id               Int             @id @default(autoincrement())
  lojaId           Int
  loja             Loja            @relation(fields: [lojaId], references: [id])
  name             String
  description      String?
  precoPromocional Decimal         @db.Decimal(10, 2)
  validoDe         DateTime?
  validoAte        DateTime?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  produtos         OfertaProduto[]

  @@index([lojaId])
  @@map("ofertas")
}

/// Tabela de junção Oferta <-> Product (many-to-many)
model OfertaProduto {
  ofertaId  Int
  oferta    Oferta  @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([ofertaId, productId])
  @@map("ofertas_produtos")
}

/// Pedido feito por um cliente
model Order {
  id            Int          @id @default(autoincrement())
  lojaId        Int
  loja          Loja         @relation(fields: [lojaId], references: [id])
  customerName  String
  phone         String // Criptografado no banco (de/encrypt no app)
  address       String? // Criptografado no banco
  deliveryType  DeliveryType   @default(ENTREGA)
  paymentMethod FormaPagamento
  notes         String?
  status        OrderStatus  @default(RECEBIDO)
  origem        OrigemPedido @default(TELEFONE)
  deliveryFee   Decimal      @default(0) @db.Decimal(10, 2)
  totalPrice    Decimal      @db.Decimal(10, 2)
  // Atendente que registrou o pedido (fluxo interno). Nullable p/ pedidos legados/integrações.
  atendenteId   Int?
  atendente     Admin?       @relation(fields: [atendenteId], references: [id])
  // Cliente vinculado (histórico por telefone, isolado por loja).
  clienteId     Int?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id])
  items         OrderItem[]

  // Módulo Motoboy: entregador designado ao sair para entrega, e o turno em que a entrega caiu.
  // false = pago antecipado (PIX/online), true = cobrar em dinheiro/cartão na entrega.
  cobradoNaEntrega Boolean       @default(true)
  motoboyId        Int?
  motoboy          Admin?        @relation("PedidosMotoboy", fields: [motoboyId], references: [id])
  turnoMotoboyId   Int?
  turnoMotoboy     TurnoMotoboy? @relation(fields: [turnoMotoboyId], references: [id])
  entregueEm       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId, status])
  @@index([atendenteId])
  @@index([clienteId])
  @@index([motoboyId, status])
  @@index([turnoMotoboyId])
  @@map("orders")
}

/// Cliente cadastrado por loja (histórico de tele-entrega).
/// Isolado por lojaId: o mesmo telefone em lojas diferentes = clientes diferentes.
/// phoneHash é determinístico (HMAC) só para permitir busca; endereço fica criptografado.
model Cliente {
  id        Int      @id @default(autoincrement())
  lojaId    Int
  loja      Loja     @relation(fields: [lojaId], references: [id])
  phoneHash String // HMAC-SHA256 do telefone normalizado (determinístico, pesquisável)
  name      String
  address   String? // Criptografado no banco (mesmo tratamento de Order.address)
  pedidos   Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lojaId, phoneHash])
  @@index([lojaId])
  @@map("clientes")
}

/// Comanda de mesa/balcão do salão (grade configurável de grupos/botões).
/// Fluxo separado da tele-entrega. numeroMesa é um campo solto (sem FK) —
/// null quando LojaConfig.usaMesa=false (venda de balcão/avulsa).
model Comanda {
  id     Int  @id @default(autoincrement())
  lojaId Int
  loja   Loja @relation(fields: [lojaId], references: [id])

  numeroMesa Int?
  status     StatusComanda @default(ABERTA)

  abertaEm  DateTime  @default(now())
  fechadaEm DateTime?

  // Uma só forma de pagamento por comanda (mesma regra do módulo Pedidos)
  paymentMethod FormaPagamento?
  totalPrice    Decimal @default(0) @db.Decimal(10, 2)

  atendenteAberturaId   Int?
  atendenteAbertura     Admin? @relation("ComandaAbertura", fields: [atendenteAberturaId], references: [id])
  atendenteFechamentoId Int?
  atendenteFechamento   Admin? @relation("ComandaFechamento", fields: [atendenteFechamentoId], references: [id])

  // Preenchido no fechamento, vincula a comanda à sessão de caixa do salão
  caixaSessaoId Int?
  caixaSessao   CaixaSessao? @relation(fields: [caixaSessaoId], references: [id])

  itens ComandaItem[]

  @@index([lojaId])
  @@index([lojaId, status])
  @@index([caixaSessaoId])
  @@map("comandas")
}

/// Item de uma comanda: PIZZA (montador, com snapshot de sabores/borda) ou
/// PRODUTO (bebida/extra/rodízio, lançado direto a partir de um BotaoPDV).
model ComandaItem {
  id        Int          @id @default(autoincrement())
  comandaId Int
  comanda   Comanda      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  tipo      TipoBotaoPDV

  descricao  String // snapshot do nome/tamanho no momento da venda
  unitPrice  Decimal @db.Decimal(10, 2)
  quantidade Int     @default(1)

  // Só quando tipo = PIZZA: snapshot dos sabores (e borda) escolhidos, ex
  // [{ "nome": "Calabresa", "adicional": 5.00 }, ...]
  sabroesSnapshot Json?

  criadoEm DateTime @default(now())

  @@index([comandaId])
  @@map("comanda_items")
}

/// Configuração do módulo PDV/Salão em grade, 1:1 por loja.
model LojaConfig {
  id     Int  @id @default(autoincrement())
  lojaId Int  @unique
  loja   Loja @relation(fields: [lojaId], references: [id])

  modoAdicionalSabor ModoAdicionalSabor @default(CHEIO)
  usaBorda           Boolean            @default(false)
  usaMesa            Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loja_configs")
}

/// Grupo de botões da grade do PDV (ex "PIZZAS", "REFRIGERANTES"). 100%
/// configurável por loja — o sistema nasce vazio, sem seed.
model GrupoPDV {
  id     Int  @id @default(autoincrement())
  lojaId Int
  loja   Loja @relation(fields: [lojaId], references: [id])

  nome     String
  cor      String?
  corFonte String?
  posicao  Int
  ativo    Boolean @default(true)

  botoes BotaoPDV[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId])
  @@index([lojaId, ativo])
  @@map("grupos_pdv")
}

/// Botão individual dentro de um GrupoPDV: aponta pra PizzaSize (abre o
/// montador de sabores) ou Product (lança direto na comanda) — nunca ambos.
model BotaoPDV {
  id      Int      @id @default(autoincrement())
  lojaId  Int
  loja    Loja     @relation(fields: [lojaId], references: [id])
  grupoId Int
  grupo   GrupoPDV @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  posicao    Int
  labelBotao String
  cor        String?

  tipo        TipoBotaoPDV
  pizzaSizeId Int?
  pizzaSize   PizzaSize?   @relation(fields: [pizzaSizeId], references: [id], onDelete: Restrict)
  productId   Int?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId])
  @@index([grupoId])
  @@index([grupoId, ativo])
  @@map("botoes_pdv")
}

/// Sessão de caixa por turno (salão e tele-entrega são fundos separados)
model CaixaSessao {
  id     Int         @id @default(autoincrement())
  lojaId Int
  loja   Loja        @relation(fields: [lojaId], references: [id])
  tipo   TipoCaixa
  status StatusCaixa @default(ABERTO)

  fundoTroco   Decimal   @db.Decimal(10, 2)
  abertoPorId  Int
  abertoPor    Admin     @relation("CaixaAbertura", fields: [abertoPorId], references: [id])
  abertoEm     DateTime  @default(now())
  fechadoPorId Int?
  fechadoPor   Admin?    @relation("CaixaFechamento", fields: [fechadoPorId], references: [id])
  fechadoEm    DateTime?

  // Breakdown por forma de pagamento (calculado no fechamento a partir das comandas vinculadas).
  // Só dinheiro entra na gaveta; cartão/PIX nunca contam pro saldo em espécie.
  totalVendasDinheiro Decimal? @db.Decimal(10, 2)
  totalVendasCartao   Decimal? @db.Decimal(10, 2)
  totalVendasPix      Decimal? @db.Decimal(10, 2)
  totalSangrias       Decimal? @db.Decimal(10, 2)
  totalSuprimentos    Decimal? @db.Decimal(10, 2)

  // = fundoTroco + totalVendasDinheiro - totalSangrias + totalSuprimentos
  saldoFinalCalculado Decimal? @db.Decimal(10, 2)

  conferidoPorId    Int?
  conferidoPor      Admin?    @relation("CaixaConferencia", fields: [conferidoPorId], references: [id])
  conferidoEm       DateTime?
  saldoFinalContado Decimal?  @db.Decimal(10, 2)

  comandas   Comanda[]
  movimentos MovimentoCaixa[]

  @@index([lojaId])
  @@map("caixa_sessoes")
}

/// Sangria/suprimento do caixa. Motivo é obrigatório (auditoria).
model MovimentoCaixa {
  id            Int                @id @default(autoincrement())
  caixaSessaoId Int
  caixaSessao   CaixaSessao        @relation(fields: [caixaSessaoId], references: [id])
  tipo          TipoMovimentoCaixa
  valor         Decimal            @db.Decimal(10, 2)
  motivo        String
  adminId       Int
  admin         Admin              @relation(fields: [adminId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([caixaSessaoId])
  @@map("movimentos_caixa")
}

/// Turno de trabalho de um motoboy (despacho + fechamento/sangria). Vários motoboys podem ter
/// turno ABERTO ao mesmo tempo na mesma loja; o fechamento é sempre individual por motoboy.
model TurnoMotoboy {
  id     Int  @id @default(autoincrement())
  lojaId Int
  loja   Loja @relation(fields: [lojaId], references: [id])

  motoboyId Int
  motoboy   Admin              @relation("TurnosMotoboy", fields: [motoboyId], references: [id])
  status    StatusTurnoMotoboy @default(ABERTO)

  // Capital de giro que o motoboy leva pra rua pra dar troco; sempre retorna inteiro no acerto.
  fundoTroco Decimal @db.Decimal(10, 2)

  abertoPorId  Int
  abertoPor    Admin     @relation("TurnoMotoboyAbertura", fields: [abertoPorId], references: [id])
  abertoEm     DateTime  @default(now())
  fechadoPorId Int?
  fechadoPor   Admin?    @relation("TurnoMotoboyFechamento", fields: [fechadoPorId], references: [id])
  fechadoEm    DateTime?

  // Preenchidos no fechamento. valorPorEntrega/valorAluguelMoto são snapshot da config da loja
  // no momento do fechamento (não recalculado se a config mudar depois).
  totalEntregas    Int?
  valorPorEntrega  Decimal? @db.Decimal(10, 2)
  valorAluguelMoto Decimal? @db.Decimal(10, 2)
  totalExtras      Decimal? @db.Decimal(10, 2)

  // = (totalEntregas * valorPorEntrega) + totalExtras + valorAluguelMoto
  valorDaNoite Decimal? @db.Decimal(10, 2)

  // Dinheiro físico que o motoboy está segurando (inclui fundoTroco). Cartão/PIX são
  // informativos, digitados manualmente do relatório da maquininha (fase 1).
  totalRecebidoDinheiro Decimal? @db.Decimal(10, 2)
  totalRecebidoCartao   Decimal? @db.Decimal(10, 2)
  totalRecebidoPix      Decimal? @db.Decimal(10, 2)

  // = (totalRecebidoDinheiro - fundoTroco) - valorDaNoite.
  // > 0: motoboy deve repassar a diferença à pizzaria (sangria). < 0: pizzaria deve ao motoboy (nunca sangria).
  acerto  Decimal? @db.Decimal(10, 2)
  sangria Decimal? @db.Decimal(10, 2)

  conferidoPorId Int?
  conferidoPor   Admin?    @relation("TurnoMotoboyConferencia", fields: [conferidoPorId], references: [id])
  conferidoEm    DateTime?

  extras  ExtraMotoboy[]
  pedidos Order[]

  @@index([lojaId])
  @@index([motoboyId])
  @@map("turnos_motoboy")
}

/// Valor extra lançado no turno do motoboy (entrega longa, gorjeta, ajuda de custo, outro).
/// Motivo é obrigatório (auditoria), mesmo padrão do MovimentoCaixa.
model ExtraMotoboy {
  id             Int              @id @default(autoincrement())
  turnoMotoboyId Int
  turnoMotoboy   TurnoMotoboy     @relation(fields: [turnoMotoboyId], references: [id])
  tipo           TipoExtraMotoboy
  valor          Decimal          @db.Decimal(10, 2)
  motivo         String
  adminId        Int
  admin          Admin            @relation(fields: [adminId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([turnoMotoboyId])
  @@map("extras_motoboy")
}

/// Item de um pedido (snapshot dos dados no momento da compra)
model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemName     String
  itemType     String // MONTAVEL | COMBO | BEBIDA | ESPECIAL
  flavors      Json? // array de nomes dos sabores escolhidos
  borderName   String?
  quantity     Int     @default(1)
  unitPrice    Decimal @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(10, 2)
  observations String?

  @@map("order_items")
}

/// Usuário administrador (painel de gestão)
model Admin {
  id           Int     @id @default(autoincrement())
  // Loja à qual o operador pertence. Nullable: SUPER_ADMIN pode ser global (sem loja).
  lojaId       Int?
  loja         Loja?   @relation(fields: [lojaId], references: [id])
  name         String
  email        String  @unique
  passwordHash String
  role         String  @default("ADMIN") // SUPER_ADMIN, ADMIN, VIEWER
  active       Boolean @default(true) // false = desativado: bloqueado no login/sessão, mas preserva histórico (turnos, pedidos)

  // 2FA - TOTP
  totpSecret  String? // Secret para geração de TOTP (Google Authenticator)
  totpEnabled Boolean @default(false)
  backupCodes String? // JSON array de backup codes (criptografado)

  // Auditoria
  lastLoginAt DateTime?
  lastLoginIp String?
  auditLogs   AuditLog[] // Relação com logs de auditoria
  pedidos     Order[] // Pedidos registrados por este atendente

  // Módulo PDV Salão/Caixa
  comandasAbertas  Comanda[]        @relation("ComandaAbertura")
  comandasFechadas Comanda[]        @relation("ComandaFechamento")
  caixasAbertos    CaixaSessao[]    @relation("CaixaAbertura")
  caixasFechados   CaixaSessao[]    @relation("CaixaFechamento")
  caixasConferidos CaixaSessao[]    @relation("CaixaConferencia")
  movimentosCaixa  MovimentoCaixa[]

  // Módulo Motoboy (role "MOTOBOY" quando o próprio entregador acessa o sistema)
  pedidosEntregues        Order[]        @relation("PedidosMotoboy")
  turnosMotoboy           TurnoMotoboy[] @relation("TurnosMotoboy")
  turnosMotoboyAbertos    TurnoMotoboy[] @relation("TurnoMotoboyAbertura")
  turnosMotoboyFechados   TurnoMotoboy[] @relation("TurnoMotoboyFechamento")
  turnosMotoboyConferidos TurnoMotoboy[] @relation("TurnoMotoboyConferencia")
  extrasMotoboyLancados   ExtraMotoboy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId])
  @@map("admins")
}

/// Log de auditoria - rastreia todas as mudanças no catálogo
/// Permite investigar: quem mudou, o quê, quando, de qual IP
model AuditLog {
  id       Int    @id @default(autoincrement())
  table    String // "PizzaSize", "Flavor", "Border", "Product"
  recordId Int // ID do registro modificado
  action   String // "CREATE", "UPDATE", "DELETE"
  adminId  Int // ID do admin que fez a mudança
  admin    Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // Snapshots antes/depois (JSON para rastreabilidade completa)
  before Json? // Estado anterior (null se CREATE)
  after  Json? // Estado novo (null se DELETE)

  // Contexto da mudança
  ip        String // IP do cliente
  userAgent String? // Browser/client info
  timestamp DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([table, recordId])
  @@index([adminId, timestamp])
  @@index([timestamp])
  @@map("audit_logs")
}

/// Loja (unidade da rede). Dona da configuração e alvo dos pedidos.
/// Por ora existe 1 registro em produção; a estrutura já suporta múltiplas lojas.
model Loja {
  id              Int     @id @default(autoincrement())
  nome            String
  whatsapp        String // Criptografado no banco
  phone           String // Criptografado no banco
  address         String // Criptografado no banco
  city            String
  state           String
  zipCode         String
  ifoodUrl        String?
  instagramUrl    String?
  facebookUrl     String?
  openingHours    Json
  minDeliveryFee  Decimal @default(10) @db.Decimal(10, 2)
  maxDeliveryFee  Decimal @default(20) @db.Decimal(10, 2)
  minDeliveryTime Int     @default(40)
  maxDeliveryTime Int     @default(70)
  isOpen          Boolean @default(true)

  // Módulo Motoboy: valores configuráveis por loja (repasse por entrega + aluguel de moto/noite)
  valorPorEntregaMotoboy Decimal @default(14) @db.Decimal(10, 2)
  valorAluguelMotoNoite  Decimal @default(20) @db.Decimal(10, 2)

  pedidos       Order[]
  admins        Admin[]
  clientes      Cliente[]
  pizzaSizes    PizzaSize[]
  flavors       Flavor[]
  borders       Border[]
  products      Product[]
  comandas      Comanda[]
  caixaSessoes  CaixaSessao[]
  turnosMotoboy TurnoMotoboy[]
  ofertas       Oferta[]
  lojaConfig    LojaConfig?
  gruposPdv     GrupoPDV[]
  botoesPdv     BotaoPDV[]
  jobsImpressao JobImpressao[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("lojas")
}

/// Job de impressão térmica. Persistido para permitir reimpressão e diagnóstico
/// ("o pedido 412 saiu na cozinha?") sem depender de o agente local estar online.
///
/// A impressora é USB/rede dentro da pizzaria e o backend roda na nuvem: quem imprime é o
/// agente local, que consome esta fila via WebSocket (e via GET /pendentes no reconnect).
model JobImpressao {
  id     Int  @id @default(autoincrement())
  lojaId Int
  loja   Loja @relation(fields: [lojaId], references: [id])

  tipo   TipoImpressao
  status StatusImpressao @default(PENDENTE)

  /// Texto já renderizado em linhas pelo backend — o agente não conhece regra de negócio,
  /// só converte para ESC/POS. Formato: { titulo, linhas: [{ texto, estilo }] }.
  payload Json

  /// Referência solta à origem (Order.id, Comanda.id ou TurnoMotoboy.id), sem FK:
  /// o job sobrevive à origem e o `tipo` diz qual tabela consultar.
  origemId Int?

  tentativas Int       @default(0)
  erro       String?
  impressoEm DateTime?
  createdAt  DateTime  @default(now())

  @@index([lojaId, status])
  @@map("jobs_impressao")
}
