# ==============================
# Configuração do Banco (Supabase / PostgreSQL)
# ==============================
DATABASE_URL="postgresql://postgres:[SUA_SENHA]@[SEU_PROJETO].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres"

# ==============================
# Servidor
# ==============================
PORT=3333
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
# Em produção: NODE_ENV="production" e use HTTPS

# ==============================
# CORS IP Whitelist (Produção)
# ==============================
# IPs adicionais permitidos (além de localhost)
# Formato: IP1,IP2,IP3 ou use wildcard 192.168.1.*
# Exemplo: CORS_IP_WHITELIST=192.168.1.100,10.0.0.1,192.168.1.*
# Em desenvolvimento: não é validado
CORS_IP_WHITELIST=""

# ==============================
# Autenticação JWT
# ==============================
# IMPORTANTE: Gere uma chave segura com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="chave_muito_secreta_32_caracteres_hexadecimais"
JWT_EXPIRES_IN="8h"

# ==============================
# Redis (Token Blacklist)
# ==============================
REDIS_URL="redis://localhost:6379"
# Para Heroku/Render: redis://:password@host:port

# ==============================
# 2FA (TOTP)
# ==============================
TOTP_WINDOW=2
# Janela de tolerância para TOTP (em passos de 30s, padrão 2 = ±60s)
