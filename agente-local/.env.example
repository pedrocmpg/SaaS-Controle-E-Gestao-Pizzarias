# Configuracao do agente de impressao.
# Copie este arquivo para ".env" (sem o .example) e preencha as linhas abaixo.

# Endereco do sistema, sem barra no final e SEM o /api.
BACKEND_URL=https://api.seudominio.com.br

# Token do usuario de servico DESTA pizzaria. Fornecido pelo suporte.
# Cada pizzaria tem o seu: nunca reaproveite o token de outra loja.
AGENTE_TOKEN=

# Marca da impressora: epson | star | tanca | daruma | brother
# Na duvida, deixe epson (a maioria das termicas usa o padrao Epson).
IMPRESSORA_TIPO=epson

# Como o PC enxerga a impressora. Escolha UMA das formas:
#   printer:POS-80            -> impressora instalada no Windows (use o nome exato dela)
#   tcp://192.168.0.100:9100  -> impressora de rede (use o IP dela)
# O README.md explica como descobrir o nome ou o IP.
IMPRESSORA_INTERFACE=printer:POS-80

# Largura do papel: 48 para bobina de 80mm, 32 para bobina de 58mm.
LARGURA_COLUNAS=48
